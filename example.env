# Copy to .env for local runs, or set the same names in Koyeb / Heroku.
# Never commit a filled-in copy - it holds your bot token and DB password.
# Required: API_ID, API_HASH, BOT_TOKEN, DATABASE_URI, LOG_CHANNEL, BIN_CHANNEL.
# The bot now fails at startup with a clear "Missing required environment
# variable: X" message instead of a bare int('') crash if one is missing.

API_ID=
API_HASH=
BOT_TOKEN=
ADMINS=
DATABASE_URI=
DATABASE_NAME=
COLLECTION_NAME=Telegram_files
LOG_CHANNEL=
BIN_CHANNEL=
MOVIE_UPDATE_CHANNEL=
CHANNELS=
AUTH_CHANNEL=
AUTH_REQ_CHANNEL=
SUPPORT_GROUP=
FQDN=
PORT=8080
# Your own links - the old code hardcoded the previous owner's
# (AM_FILMS / GUARDIANff). Set these or the Support / owner buttons
# will have an empty URL.
SUPPORT_LNK=
OWNER_LNK=
CHNL_LNK=
GRP_LNK=
UPDATE_CHANNEL_LNK=
SUPPORT_CHAT=
IS_VERIFY=False
MULTIPLE_DB=False
DATABASE_URI2=
